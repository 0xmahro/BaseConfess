# ── Supabase ───────────────────────────────────────────────────────────────────
# Get from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── WalletConnect ──────────────────────────────────────────────────────────────
# Get a free Project ID from: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# ── MiniApp ─────────────────────────────────────────────────────────────────────
# Your production URL (used in farcaster.json manifest and og tags)
NEXT_PUBLIC_URL=https://baseconfess.fun

# ── Base Builder Code (ERC-8021 attribution on transactions) ────────────────────
# https://docs.base.org/base-chain/builder-codes/app-developers
# NEXT_PUBLIC_BASE_BUILDER_CODE=bc_yourcode

# ── Love Meter ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_LOVE_METER_ADDRESS=0x8765bd20c3cC2bCa9e9E42f40447FC0D09e54FA3
# ── Legacy Confessions Contracts (for old feed vote routing) ────────────────────
NEXT_PUBLIC_LEGACY_CONFESSIONS_ADDRESS=0xeaa890e6c93264B498773425b6f8f02726c143F4
NEXT_PUBLIC_LEGACY_CONFESSIONS_ADDRESS_2=0xD11cB9c3F69650293370Ea38eb688010E0DDCe8d
# Optional: dedicated RPC for Love Meter stats API (defaults to https://mainnet.base.org)
# LOVE_METER_RPC_URL=https://mainnet.base.org
# Optional: contract creation block on Base (Basescan → Contract → Details). Needed to count tests if the contract has no totalTests() yet.
# NEXT_PUBLIC_LOVE_METER_DEPLOY_BLOCK=12345678
